<UserControl x:Class="SmartSectionBox.UI.SectionBoxDockPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Background="#F4F6F8" Foreground="#1F2933">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#005A9E" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Button Content="Activate Smart Section Box" Command="{Binding ActivateCommand}" />
        <TextBlock Text="{Binding DisplayStatus}" Foreground="#0B5F93" FontSize="11"
                   TextWrapping="Wrap" Margin="2,7,2,0" />
        <CheckBox Content="Record diagnostics" IsChecked="{Binding InteractionDiagnosticsEnabled, Mode=TwoWay}"
                  ToolTip="Records pick and drag details only when troubleshooting."
                  Foreground="#52606D" FontSize="11" Margin="2,7,2,0" />
    </StackPanel>
</UserControl>
