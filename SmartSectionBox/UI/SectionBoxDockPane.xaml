<UserControl x:Class="SmartSectionBox.UI.SectionBoxDockPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260" MinHeight="560" Background="#242424" Foreground="#E6E6E6">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Background" Value="#404040" />
            <Setter Property="Foreground" Value="#F4F4F4" />
            <Setter Property="BorderBrush" Value="#5A5A5A" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Background" Value="#161616" />
            <Setter Property="Foreground" Value="#F4F4F4" />
            <Setter Property="BorderBrush" Value="#5A5A5A" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="3" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="SMART SECTION BOX" FontWeight="Bold" FontSize="15" Margin="3,3,3,8" />
            <DockPanel Margin="3,0,3,8">
                <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontWeight="SemiBold" />
                <CheckBox Content="Live" IsChecked="{Binding LiveUpdates, Mode=TwoWay}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
            </DockPanel>

            <TextBlock Text="Face coordinates (model units)" Foreground="#B8B8B8" Margin="3,2" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Min X" VerticalAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MinX:-1" />
                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding MinX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F4}" />
                <Button Grid.Row="0" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MinX:1" />
                <Slider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" Value="{Binding MinX, Mode=TwoWay}" SmallChange="{Binding StepSize}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Max X" VerticalAlignment="Center" />
                <Button Grid.Row="2" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MaxX:-1" />
                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding MaxX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F4}" />
                <Button Grid.Row="2" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MaxX:1" />
                <Slider Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" Value="{Binding MaxX, Mode=TwoWay}" SmallChange="{Binding StepSize}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Min Y" VerticalAlignment="Center" />
                <Button Grid.Row="4" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MinY:-1" />
                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding MinY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F4}" />
                <Button Grid.Row="4" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MinY:1" />
                <Slider Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" Value="{Binding MinY, Mode=TwoWay}" SmallChange="{Binding StepSize}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Max Y" VerticalAlignment="Center" />
                <Button Grid.Row="6" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MaxY:-1" />
                <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding MaxY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F4}" />
                <Button Grid.Row="6" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MaxY:1" />
                <Slider Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" Value="{Binding MaxY, Mode=TwoWay}" SmallChange="{Binding StepSize}" />

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Min Z" VerticalAlignment="Center" />
                <Button Grid.Row="8" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MinZ:-1" />
                <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding MinZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F4}" />
                <Button Grid.Row="8" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MinZ:1" />
                <Slider Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4" Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" Value="{Binding MinZ, Mode=TwoWay}" SmallChange="{Binding StepSize}" />

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Max Z" VerticalAlignment="Center" />
                <Button Grid.Row="10" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MaxZ:-1" />
                <TextBox Grid.Row="10" Grid.Column="2" Text="{Binding MaxZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F4}" />
                <Button Grid.Row="10" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MaxZ:1" />
                <Slider Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="4" Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" Value="{Binding MaxZ, Mode=TwoWay}" SmallChange="{Binding StepSize}" />
            </Grid>

            <UniformGrid Columns="2" Margin="0,8,0,3">
                <Button Content="Fit to Selection" Command="{Binding FitSelectionCommand}" />
                <Button Content="Fit to Model" Command="{Binding FitModelCommand}" />
                <Button Content="Reset" Command="{Binding ResetCommand}" />
                <Button Content="Invert" Command="{Binding InvertCommand}" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            </UniformGrid>

            <Separator Margin="3,8" />
            <TextBlock Text="Preset (document-scoped)" Foreground="#B8B8B8" Margin="3,2" />
            <DockPanel>
                <TextBox Text="{Binding PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="100" />
                <Button Content="Save" Command="{Binding SavePresetCommand}" />
                <Button Content="Load" Command="{Binding LoadPresetCommand}" />
                <Button Content="Delete" Command="{Binding DeletePresetCommand}" />
            </DockPanel>

            <Border Background="#1A1A1A" BorderBrush="#454545" BorderThickness="1" Padding="7" Margin="3,9,3,3">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#BFE4FF" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
