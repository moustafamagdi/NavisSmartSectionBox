<UserControl x:Class="SmartSectionBox.UI.SectionBoxDockPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0" MinHeight="0" Background="#F4F6F8" Foreground="#1F2933">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#005A9E" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="2,7,2,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <TextBlock Text="SMART SECTION BOX" FontWeight="Bold" FontSize="16" Margin="2,2,2,1" />
            <TextBlock Text="Select a model element, or retain an existing Navisworks Box section. Then activate and pull faces directly in the 3D view."
                       Foreground="#4C6378" TextWrapping="Wrap" Margin="2,0,2,9" />

            <Border Background="White" BorderBrush="#C7D0D9" BorderThickness="1" Padding="8" Margin="2">
                <StackPanel>
                    <TextBlock Text="DIRECT FACE MANIPULATION" FontSize="11" FontWeight="SemiBold" Foreground="#0B5F93" Margin="1,0,1,5" />
                    <Button Content="Activate Smart Section Box" Command="{Binding ActivateCommand}" />
                    <TextBlock Text="Red faces are the camera-facing faces. Hold Ctrl while dragging to pick yellow underlay faces."
                               Foreground="#52606D" FontSize="11" TextWrapping="Wrap" Margin="2,6,2,0" />
                    <CheckBox Content="Record face-pull diagnostics" IsChecked="{Binding InteractionDiagnosticsEnabled, Mode=TwoWay}"
                              ToolTip="Logs pointer location, candidate faces, selected face, and drag result." />
                </StackPanel>
            </Border>

            <Border Background="#F8FAFC" BorderBrush="#C7D0D9" BorderThickness="1" Padding="7" Margin="2,8,2,2">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#0B5F93" FontSize="11" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
