<UserControl x:Class="SmartSectionBox.UI.SectionBoxDockPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0" MinHeight="0" Background="#252525" Foreground="#F0F0F0">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Background" Value="#444444" />
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="BorderBrush" Value="#676767" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#146B94" />
            <Setter Property="BorderBrush" Value="#249ACB" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Background" Value="#141414" />
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="BorderBrush" Value="#606060" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Margin" Value="2,7,2,2" />
            <Setter Property="Foreground" Value="#D6D6D6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8">
            <TextBlock Text="SMART SECTION BOX" FontWeight="Bold" FontSize="15" Margin="2,2,2,1" />
            <TextBlock Text="Create a box, then drag a face in the 3D view or enter an exact value below."
                       Foreground="#B8DDF0" TextWrapping="Wrap" Margin="2,0,2,7" />

            <Border Background="#1B1B1B" BorderBrush="#4B4B4B" BorderThickness="1" Padding="5" Margin="2">
                <StackPanel>
                    <TextBlock Text="1. CREATE OR REFIT" FontSize="11" FontWeight="SemiBold" Foreground="#AFCFE0" Margin="1,0,1,3" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Fit to Model" Style="{StaticResource PrimaryButton}" Command="{Binding FitModelCommand}" />
                        <Button Grid.Column="1" Content="Fit to Selection" Command="{Binding FitSelectionCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#1B1B1B" BorderBrush="#4B4B4B" BorderThickness="1" Padding="5" Margin="2">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="2. EDIT SECTION BOX" FontSize="11" FontWeight="SemiBold" Foreground="#AFCFE0" DockPanel.Dock="Left" />
                        <CheckBox Content="Live" IsChecked="{Binding LiveUpdates, Mode=TwoWay}" HorizontalAlignment="Right" ToolTip="Update the model while dragging" />
                        <CheckBox Content="On" IsChecked="{Binding Enabled, Mode=TwoWay}" HorizontalAlignment="Right" ToolTip="Enable or disable the current section box" />
                    </DockPanel>
                    <TextBlock Text="Type a value or use − / +. Coordinates are in model units." Foreground="#BDBDBD" FontSize="10" TextWrapping="Wrap" Margin="1,0,1,3" />
                    <Grid IsEnabled="{Binding IsBoxReady}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="27" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="27" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Min X" VerticalAlignment="Center" />
                        <Button Grid.Row="0" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MinX:-1" />
                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding MinX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F3}" />
                        <Button Grid.Row="0" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MinX:1" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max X" VerticalAlignment="Center" />
                        <Button Grid.Row="1" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MaxX:-1" />
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding MaxX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F3}" />
                        <Button Grid.Row="1" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MaxX:1" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Min Y" VerticalAlignment="Center" />
                        <Button Grid.Row="2" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MinY:-1" />
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding MinY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F3}" />
                        <Button Grid.Row="2" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MinY:1" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Max Y" VerticalAlignment="Center" />
                        <Button Grid.Row="3" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MaxY:-1" />
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding MaxY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F3}" />
                        <Button Grid.Row="3" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MaxY:1" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Min Z" VerticalAlignment="Center" />
                        <Button Grid.Row="4" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MinZ:-1" />
                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding MinZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F3}" />
                        <Button Grid.Row="4" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MinZ:1" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Max Z" VerticalAlignment="Center" />
                        <Button Grid.Row="5" Grid.Column="1" Content="−" Command="{Binding NudgeCommand}" CommandParameter="MaxZ:-1" />
                        <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding MaxZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F3}" />
                        <Button Grid.Row="5" Grid.Column="3" Content="+" Command="{Binding NudgeCommand}" CommandParameter="MaxZ:1" />
                    </Grid>
                    <TextBlock Text="Click Fit to Model or Fit to Selection to activate editing." Foreground="#E7C47D" FontSize="10" Margin="1,3,1,0" Visibility="{Binding IsBoxNotReady, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Border>

            <Grid Margin="2,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Disable Section" Command="{Binding ResetCommand}" />
                <Button Grid.Column="1" Content="Read Native Box" Command="{Binding RefreshCommand}" />
            </Grid>

            <Expander Header="Presets" IsExpanded="False">
                <StackPanel Margin="2">
                    <TextBox Text="{Binding PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Save" Command="{Binding SavePresetCommand}" />
                        <Button Grid.Column="1" Content="Load" Command="{Binding LoadPresetCommand}" />
                        <Button Grid.Column="2" Content="Delete" Command="{Binding DeletePresetCommand}" />
                    </Grid>
                </StackPanel>
            </Expander>

            <Border Background="#141414" BorderBrush="#4B4B4B" BorderThickness="1" Padding="6" Margin="2,6,2,2">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#BFE4FF" FontSize="11" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
